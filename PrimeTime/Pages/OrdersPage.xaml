<Page x:Class="PrimeTime.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PrimeTime.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Заявки" Background="{StaticResource BgBrush}">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock x:Name="txtTitle" Text="Заявки" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" Grid.Row="0"></TextBlock>
            <Border Style="{StaticResource PTCardBorder}" Padding="14,10,14,10" Margin="0,0,0,12" Grid.Row="1">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"></TextBlock>
                    <TextBox x:Name="txtSearch" Style="{StaticResource PTTextBox}" Width="220" Margin="0,0,18,0" TextChanged="SearchTextChanged"></TextBox>
                    <TextBlock Text="Статус:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"></TextBlock>
                    <ComboBox x:Name="cbStatus" Style="{StaticResource PTComboBox}" Width="180" Margin="0" SelectionChanged="StatusChanged"></ComboBox>
                </WrapPanel>
            </Border>
            <Grid Grid.Row="2">
                <ListBox x:Name="lbOrders" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"></Setter>
                            <Setter Property="Padding" Value="0"></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PTCardBorder}" Padding="16,12,16,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"></TextBlock>
                                        <TextBlock Text="{Binding DisplayClient}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"></TextBlock>
                                        <TextBlock Text="{Binding DisplayInfo}" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"></TextBlock>
                                        <TextBlock Text="{Binding DisplayWhen}" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"></TextBlock>
                                        <TextBlock Text="{Binding DisplayCost}" FontSize="14" FontWeight="SemiBold" Foreground="#C0688A" Margin="0,6,0,0"></TextBlock>
                                        <TextBlock Text="{Binding DisplayPaid}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Width="140">
                                        <Border Background="{Binding StatusColor}" CornerRadius="8" Padding="8,4,8,4">
                                            <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"></TextBlock>
                                        </Border>
                                        <Button Content="Изменить" Tag="{Binding Id}" Visibility="{Binding EditVisibility}" Style="{StaticResource PTPrimaryButton}" Height="32" Margin="0,10,0,0" Click="BtnEdit_Click"></Button>
                                        <Button Content="Удалить" Tag="{Binding Id}" Visibility="{Binding DeleteVisibility}" Style="{StaticResource PTSecondaryButton}" Height="32" Margin="0,6,0,0" Click="BtnDelete_Click"></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="txtEmpty" Text="Заявок не найдено" FontSize="16" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Visibility="Collapsed"></TextBlock>
            </Grid>
        </Grid>
    </Page>