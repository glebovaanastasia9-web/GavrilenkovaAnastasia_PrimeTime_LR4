<Page x:Class="PrimeTime.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PrimeTime.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Главная" Background="{StaticResource BgBrush}">
    <Grid>
        <Border Style="{StaticResource PTCardBorder}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource PinkStrongBrush}" Margin="4"></Ellipse>
                    <Ellipse Width="12" Height="12" Fill="{StaticResource PeachStrongBrush}" Margin="4"></Ellipse>
                    <Ellipse Width="12" Height="12" Fill="{StaticResource YellowStrongBrush}" Margin="4"></Ellipse>
                    <Ellipse Width="12" Height="12" Fill="{StaticResource GreenStrongBrush}" Margin="4"></Ellipse>
                    <Ellipse Width="12" Height="12" Fill="{StaticResource BlueStrongBrush}" Margin="4"></Ellipse>
                </StackPanel>
                <TextBlock Text="Prime Time" FontSize="32" FontWeight="Bold" Foreground="#C0688A" HorizontalAlignment="Center"></TextBlock>
                <TextBlock Text="Центр организации праздников и мероприятий" FontSize="15" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,4,0,18"></TextBlock>
                <Border Background="{StaticResource YellowBrush}" CornerRadius="10" Padding="14">
                    <TextBlock x:Name="txtGreeting" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center"></TextBlock>
                </Border>
                <Button x:Name="BtnLogin" Content="Войти" Style="{StaticResource PTPrimaryButton}" Margin="0,18,0,4" Click="BtnLogin_Click"></Button>
                <Button x:Name="BtnRegister" Content="Создать личный кабинет" Style="{StaticResource PTSecondaryButton}" Click="BtnRegister_Click"></Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>