<Page x:Class="PrimeTime.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PrimeTime.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="850"
      Title="Оформление заявки" Background="{StaticResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource PTCardBorder}" Width="820" Margin="20" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Заявка на мероприятие" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"></TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="24"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="*Название мероприятия:" Style="{StaticResource PTLabel}"></TextBlock>
                            <TextBox x:Name="txtTitle" Style="{StaticResource PTTextBox}" MaxLength="150"></TextBox>
                            <TextBlock Text="*Тип мероприятия:" Style="{StaticResource PTLabel}"></TextBlock>
                            <ComboBox x:Name="cbType" Style="{StaticResource PTComboBox}" DisplayMemberPath="Name"></ComboBox>
                            <TextBlock Text="*Площадка:" Style="{StaticResource PTLabel}"></TextBlock>
                            <ComboBox x:Name="cbVenue" Style="{StaticResource PTComboBox}" DisplayMemberPath="Title"></ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="12"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="*Дата:" Style="{StaticResource PTLabel}"></TextBlock>
                                    <DatePicker x:Name="dpDate" Style="{StaticResource PTDatePicker}"></DatePicker>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="*Количество гостей:" Style="{StaticResource PTLabel}"></TextBlock>
                                    <TextBox x:Name="txtGuests" Style="{StaticResource PTTextBox}" MaxLength="4"></TextBox>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="12"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="*Начало (чч:мм):" Style="{StaticResource PTLabel}"></TextBlock>
                                    <TextBox x:Name="txtStart" Style="{StaticResource PTTextBox}" MaxLength="5" Text="18:00"></TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="*Окончание (чч:мм):" Style="{StaticResource PTLabel}"></TextBlock>
                                    <TextBox x:Name="txtEnd" Style="{StaticResource PTTextBox}" MaxLength="5" Text="23:00"></TextBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дополнительные услуги (отметьте и укажите количество):" Style="{StaticResource PTLabel}" Margin="2,0,0,6"></TextBlock>
                            <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="10">
                                <ItemsControl x:Name="icServices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Grid.Column="0"></CheckBox>
                                                <TextBlock Text="{Binding DisplayPrice}" Foreground="#C0688A" VerticalAlignment="Center" Margin="8,0,8,0" Grid.Column="1"></TextBlock>
                                                <TextBox Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="2"></TextBox>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="Для кейтеринга укажите количество гостей." Style="{StaticResource PTLabel}" Margin="2,6,0,0"></TextBlock>
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource YellowBrush}" CornerRadius="10" Padding="14,10,14,10" Margin="0,8,0,0">
                        <TextBlock x:Name="txtTotal" Text="Предварительная стоимость: нажмите «Рассчитать»" FontSize="15" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"></TextBlock>
                    </Border>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="12"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button Content="Рассчитать стоимость" Style="{StaticResource PTSecondaryButton}" Grid.Column="0" Click="BtnCalculate_Click"></Button>
                        <Button Content="Оформить заявку" Style="{StaticResource PTPrimaryButton}" Grid.Column="2" Click="BtnSave_Click"></Button>
                    </Grid>
                    <Button Content="Назад в каталог" Style="{StaticResource PTLinkButton}" Click="BtnCancel_Click"></Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Page>