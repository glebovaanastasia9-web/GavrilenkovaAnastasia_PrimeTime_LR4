<Application x:Class="PrimeTime.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrimeTime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgBrush" Color="#F6F3EF"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBrush" Color="#4A4543"></SolidColorBrush>
            <SolidColorBrush x:Key="MutedBrush" Color="#8C857F"></SolidColorBrush>
            <SolidColorBrush x:Key="ButtonTextBrush" Color="#5B4636"></SolidColorBrush>
            <SolidColorBrush x:Key="LineBrush" Color="#E6E0DA"></SolidColorBrush>
            <SolidColorBrush x:Key="PeachBrush" Color="#FFD9BD"></SolidColorBrush>
            <SolidColorBrush x:Key="PeachStrongBrush" Color="#F7BE95"></SolidColorBrush>
            <SolidColorBrush x:Key="PinkBrush" Color="#FBDCE8"></SolidColorBrush>
            <SolidColorBrush x:Key="PinkStrongBrush" Color="#F4B3CB"></SolidColorBrush>
            <SolidColorBrush x:Key="YellowBrush" Color="#FFF3C4"></SolidColorBrush>
            <SolidColorBrush x:Key="YellowStrongBrush" Color="#F9E08C"></SolidColorBrush>
            <SolidColorBrush x:Key="GreenBrush" Color="#D5EED3"></SolidColorBrush>
            <SolidColorBrush x:Key="GreenStrongBrush" Color="#A9D9AC"></SolidColorBrush>
            <SolidColorBrush x:Key="BlueBrush" Color="#D2E8F7"></SolidColorBrush>
            <SolidColorBrush x:Key="BlueStrongBrush" Color="#A6D0EC"></SolidColorBrush>
            <LinearGradientBrush x:Key="FestiveBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F4B3CB" Offset="0"></GradientStop>
                <GradientStop Color="#F7BE95" Offset="0.25"></GradientStop>
                <GradientStop Color="#F9E08C" Offset="0.5"></GradientStop>
                <GradientStop Color="#A9D9AC" Offset="0.75"></GradientStop>
                <GradientStop Color="#A6D0EC" Offset="1"></GradientStop>
            </LinearGradientBrush>
            <ControlTemplate x:Key="PTButtonTemplate" TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.8"></Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.65"></Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="bd" Property="Opacity" Value="0.5"></Setter>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <ControlTemplate x:Key="PTMenuButtonTemplate" TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#FBDCE8"></Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#F4B3CB"></Setter>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <Style x:Key="PTTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="36"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="Padding" Value="8,2,8,2"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="Background" Value="White"></Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BlueStrongBrush}"></Setter>
                <Setter Property="BorderThickness" Value="1.5"></Setter>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"></Setter>
                <Setter Property="Margin" Value="0,3,0,10"></Setter>
            </Style>
            <Style x:Key="PTPasswordBox" TargetType="PasswordBox">
                <Setter Property="Height" Value="36"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="Padding" Value="8,2,8,2"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="Background" Value="White"></Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BlueStrongBrush}"></Setter>
                <Setter Property="BorderThickness" Value="1.5"></Setter>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"></Setter>
                <Setter Property="Margin" Value="0,3,0,10"></Setter>
            </Style>
            <Style x:Key="PTLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"></Setter>
                <Setter Property="Margin" Value="2,0,0,0"></Setter>
            </Style>
            <Style x:Key="PTPrimaryButton" TargetType="Button">
                <Setter Property="Height" Value="40"></Setter>
                <Setter Property="Background" Value="{StaticResource PeachStrongBrush}"></Setter>
                <Setter Property="Foreground" Value="{StaticResource ButtonTextBrush}"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="FontWeight" Value="SemiBold"></Setter>
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="Cursor" Value="Hand"></Setter>
                <Setter Property="Margin" Value="0,8,0,4"></Setter>
                <Setter Property="Template" Value="{StaticResource PTButtonTemplate}"></Setter>
            </Style>
            <Style x:Key="PTSecondaryButton" TargetType="Button">
                <Setter Property="Height" Value="40"></Setter>
                <Setter Property="Background" Value="{StaticResource GreenStrongBrush}"></Setter>
                <Setter Property="Foreground" Value="#2F5D3A"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="FontWeight" Value="SemiBold"></Setter>
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="Cursor" Value="Hand"></Setter>
                <Setter Property="Margin" Value="0,8,0,4"></Setter>
                <Setter Property="Template" Value="{StaticResource PTButtonTemplate}"></Setter>
            </Style>
            <Style x:Key="PTLinkButton" TargetType="Button">
                <Setter Property="Height" Value="34"></Setter>
                <Setter Property="Background" Value="Transparent"></Setter>
                <Setter Property="Foreground" Value="#C0688A"></Setter>
                <Setter Property="FontSize" Value="13"></Setter>
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="Cursor" Value="Hand"></Setter>
                <Setter Property="Margin" Value="0,6,0,0"></Setter>
                <Setter Property="Template" Value="{StaticResource PTMenuButtonTemplate}"></Setter>
            </Style>
            <Style x:Key="PTMenuButton" TargetType="Button">
                <Setter Property="Height" Value="34"></Setter>
                <Setter Property="Background" Value="Transparent"></Setter>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="FontWeight" Value="SemiBold"></Setter>
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="Cursor" Value="Hand"></Setter>
                <Setter Property="Margin" Value="4,0,4,0"></Setter>
                <Setter Property="Padding" Value="14,0,14,0"></Setter>
                <Setter Property="Template" Value="{StaticResource PTMenuButtonTemplate}"></Setter>
            </Style>
            <Style x:Key="PTCardBorder" TargetType="Border">
                <Setter Property="Background" Value="White"></Setter>
                <Setter Property="CornerRadius" Value="16"></Setter>
                <Setter Property="BorderThickness" Value="1"></Setter>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"></Setter>
                <Setter Property="Padding" Value="24"></Setter>
            </Style>
            <Style x:Key="PTComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="36"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="Padding" Value="8,2,8,2"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="Background" Value="White"></Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BlueStrongBrush}"></Setter>
                <Setter Property="BorderThickness" Value="1.5"></Setter>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"></Setter>
                <Setter Property="Margin" Value="0,3,0,10"></Setter>
            </Style>
            <Style x:Key="PTDatePicker" TargetType="DatePicker">
                <Setter Property="Height" Value="36"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BlueStrongBrush}"></Setter>
                <Setter Property="BorderThickness" Value="1.5"></Setter>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"></Setter>
                <Setter Property="Margin" Value="0,3,0,10"></Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>